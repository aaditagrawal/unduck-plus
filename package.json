{
  "name": "unduck",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsrs && vite build",
    "preview": "vite preview",
    "lint": "oxlint .",
    "format": "oxfmt --write \"**/*.{js,mjs,cjs,ts,tsx,jsx}\" --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "format:check": "oxfmt --check \"**/*.{js,mjs,cjs,ts,tsx,jsx}\" --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix",
    "generate:bangs": "bun scripts/generate-bangs.ts",
    "typecheck": "tsrs --noEmit"
  },
  "devDependencies": {
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929"
  },
  "packageManager": "bun@1.4.3"
}
